# Web -> Blender/Sollumz worker
MAP_FORGE_WORKER_URL=http://127.0.0.1:8787
MAP_FORGE_WORKER_TOKEN=change-me-with-a-long-random-secret

# Sloyd text-to-3D (server-side only)
# Create credentials in the Sloyd API Dashboard. Never expose these as NEXT_PUBLIC_*.
SLOYD_CLIENT_ID=
SLOYD_CLIENT_SECRET=
# Production default: 2K textures. Allowed: 1k, 2k, 4k.
SLOYD_TEXTURE_RESOLUTION=2k
# Keep below 500k to avoid the Ultra tier unless you intentionally enable it.
SLOYD_TARGET_FACE_COUNT=120000

# Worker-only settings
MAP_FORGE_JOBS=./jobs
BLENDER_BIN=blender
MAP_FORGE_MAX_CONCURRENT=1
MAP_FORGE_EXPORT_TIMEOUT=1200
