# Web -> Blender/Sollumz worker
MAP_FORGE_WORKER_URL=http://127.0.0.1:8787
MAP_FORGE_WORKER_TOKEN=change-me-with-a-long-random-secret

# Tripo text-to-3D (server-side only)
# Never expose this as NEXT_PUBLIC_*.
TRIPO_API_KEY=
# Balanced default for the free trial: textured PBR model with standard texture quality.
TRIPO_MODEL_VERSION=v3.1-20260211
TRIPO_TEXTURE_QUALITY=standard
TRIPO_FACE_LIMIT=120000

# Worker-only settings
# The worker also needs TRIPO_API_KEY so it can refresh Tripo's short-lived model URL at export time.
MAP_FORGE_JOBS=./jobs
BLENDER_BIN=blender
MAP_FORGE_MAX_CONCURRENT=1
MAP_FORGE_EXPORT_TIMEOUT=1200
